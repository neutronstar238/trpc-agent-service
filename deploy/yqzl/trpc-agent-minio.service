[Unit]
Description=tRPC Agent Service MinIO object store
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
ConditionPathIsDirectory=/www/wwwroot/tx.nstarzx.cn/data/minio
ConditionPathExists=/www/wwwroot/tx.nstarzx.cn/secrets/minio_root_user
ConditionPathExists=/www/wwwroot/tx.nstarzx.cn/secrets/minio_root_password

[Service]
Type=simple
User=root
WorkingDirectory=/www/wwwroot/tx.nstarzx.cn
ExecStartPre=-/usr/bin/docker rm -f trpc-agent-minio
ExecStart=/bin/sh -ceu 'exec /usr/bin/docker run --name trpc-agent-minio --rm --init --user 1000:1000 --group-add "$(/usr/bin/id -g trpcagent)" --publish 127.0.0.1:9000:9000 --publish 127.0.0.1:9001:9001 --env MINIO_ROOT_USER_FILE=/run/secrets/minio_root_user --env MINIO_ROOT_PASSWORD_FILE=/run/secrets/minio_root_password --mount type=bind,src=/www/wwwroot/tx.nstarzx.cn/data/minio,dst=/data --mount type=bind,src=/www/wwwroot/tx.nstarzx.cn/secrets/minio_root_user,dst=/run/secrets/minio_root_user,readonly --mount type=bind,src=/www/wwwroot/tx.nstarzx.cn/secrets/minio_root_password,dst=/run/secrets/minio_root_password,readonly --read-only --tmpfs /tmp:rw,noexec,nosuid,size=64m --cap-drop=ALL --security-opt=no-new-privileges --memory=512m --memory-reservation=384m --pids-limit=256 --cpus=1.0 quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z server /data --console-address :9001'
ExecStartPost=/bin/sh -ceu 'for attempt in $(seq 1 60); do if /usr/bin/curl --fail --silent --show-error --max-time 2 http://127.0.0.1:9000/minio/health/ready >/dev/null; then exit 0; fi; sleep 1; done; exit 1'
ExecStop=/usr/bin/docker stop --time 30 trpc-agent-minio
ExecStopPost=-/usr/bin/docker rm -f trpc-agent-minio
Restart=always
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/www/wwwroot/tx.nstarzx.cn/data/minio
ReadOnlyPaths=/www/wwwroot/tx.nstarzx.cn/secrets
UMask=0027
TasksMax=256
MemoryHigh=384M
MemoryMax=512M
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
