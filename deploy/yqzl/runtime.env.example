# Copy to the host as /www/wwwroot/tx.nstarzx.cn/config/runtime.env and
# replace all placeholders.  Production must not use the development token.
TRPC_SERVICE_ENVIRONMENT=production
TRPC_SERVICE_ALLOW_DEVELOPMENT_TOKEN=false
TRPC_SERVICE_CAPTURE_CONTENT=false
TRPC_SERVICE_RUNTIME_STATE_DIR=/tmp/trpc-agent-service
TRPC_SERVICE_TENANT_SECRET_ROOT=/www/wwwroot/tx.nstarzx.cn/secrets
TRPC_SERVICE_TENANT_SECRET_ENV_NAMES=[]
TRPC_SERVICE_MODEL_ENDPOINT_HOSTS=["api.openai.com"]
TRPC_SERVICE_FEISHU_ALLOW_STALE_BINDING_CACHE=false
TRPC_SERVICE_HOST=127.0.0.1
TRPC_SERVICE_LOG_LEVEL=INFO
TRPC_SERVICE_DATABASE_DSN=postgresql://trpc_runtime@127.0.0.1:5432/trpc_agent_service
TRPC_SERVICE_DATABASE_PASSWORD_REF=file:///www/wwwroot/tx.nstarzx.cn/secrets/runtime_database_password
TRPC_SERVICE_REDIS_URL=redis://127.0.0.1:6380/0
TRPC_SERVICE_REDIS_PASSWORD_REF=file:///www/wwwroot/tx.nstarzx.cn/secrets/redis_password
TRPC_SERVICE_SCHEDULER_VERSION=v2
TRPC_SERVICE_REDIS_STREAM=trpc:session-ready:v2
TRPC_SERVICE_REDIS_CONSUMER_GROUP=trpc-session-ready-v2
TRPC_SERVICE_SESSION_HMAC_REF=file:///www/wwwroot/tx.nstarzx.cn/secrets/session_hmac_key
TRPC_SERVICE_EMERGENCY_QUEUE_KEY_REF=file:///www/wwwroot/tx.nstarzx.cn/secrets/emergency_queue_key
TRPC_SERVICE_EMERGENCY_QUEUE_KEY_VERSION=v1
TRPC_SERVICE_EMERGENCY_QUEUE_PREVIOUS_KEY_REFS={}
TRPC_SERVICE_S3_ENDPOINT=http://127.0.0.1:9000
TRPC_SERVICE_S3_BUCKET=trpc-artifacts
TRPC_SERVICE_S3_SECRET_KEY_REF=file:///www/wwwroot/tx.nstarzx.cn/secrets/minio_root_password
TRPC_SERVICE_CALLBACK_BODY_LIMIT_BYTES=2097152
TRPC_SERVICE_LEASE_SECONDS=60
TRPC_SERVICE_WORKER_POLL_SECONDS=1
