# Install as a separate HTTPS virtual host (or merge the location blocks into
# a private server block). Keep the probe on a private/VPN address or restrict
# it to the release-gate egress CIDR. The Python process itself listens only
# on loopback and does not terminate TLS.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name probe.tx.nstarzx.cn;

    ssl_certificate     /etc/letsencrypt/live/probe.tx.nstarzx.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/probe.tx.nstarzx.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;

    # Replace with the fixed egress CIDR(s) of the release-gate runner.
    allow <release-gate-egress-cidr>;
    deny all;

    location = /probe {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8750/probe;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_send_timeout 10s;
        proxy_read_timeout 240s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        access_log off;
    }

    location = /health/live {
        proxy_pass http://127.0.0.1:8750/health/live;
        proxy_set_header Host $host;
        access_log off;
    }

    location = /health/ready {
        proxy_pass http://127.0.0.1:8750/health/ready;
        proxy_set_header Host $host;
        access_log off;
    }

    location / { return 404; }
}
